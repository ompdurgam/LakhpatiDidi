{
  "name": "lakhpati-didi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.ts migrate",
    "db:rollback": "node --env-file-if-exists=.env server/db/migrate.ts rollback",
    "db:seed": "node --env-file-if-exists=.env server/db/migrate.ts seed",
    "db:reset": "node --env-file-if-exists=.env server/db/migrate.ts reset",
    "db:status": "node --env-file-if-exists=.env server/db/migrate.ts status",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/react-query": "5.106.0",
    "dexie": "4.4.7",
    "express": "5.3.0",
    "i18next": "26.7.1",
    "json-logic-js": "2.0.5",
    "mysql2": "3.24.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.12",
    "react-is": "19.3.1",
    "react-router": "7.18.5",
    "recharts": "3.10.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/express": "5.0.6",
    "@types/json-logic-js": "2.0.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
